#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

#=================================================
# STOP SYSTEMD SERVICE
#=================================================
ynh_script_progression "Stopping $app's systemd service..."

ynh_systemctl --service="$app" --action="stop" --wait_until="Shutting down job result cleanup executor" --log_path="$install_dir/logs/info.log"

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Upgrading source files..."

# Download, check integrity, uncompress and patch the source from manifest.toml
ynh_setup_source --dest_dir="$install_dir" --full_replace --keep="configs"

ynh_setup_source --dest_dir="$install_dir/jdk" --source_id="jdk"

python3 -m venv $install_dir/venv
$install_dir/venv/bin/python3 -m pip install -U pip setuptools wheel
$install_dir/venv/bin/python3 -m pip install weasyprint ocrmypdf

#=================================================
# UPDATE A CONFIG FILE
#=================================================
ynh_script_progression "Updating $app's configuration files..."

ynh_config_add --template="custom_settings.yml" --destination="$install_dir/configs/custom_settings.yml"

#=================================================
# REAPPLY SYSTEM CONFIGURATIONS
#=================================================
ynh_script_progression "Upgrading system configurations related to $app..."

ynh_config_add_nginx

local_path=$install_dir/venv/bin:$PATH
ynh_config_add_systemd

yunohost service add "$app" --description="Perform various operations on PDF files" --log="$install_dir/logs/info.log"

ynh_config_add_fail2ban --logpath="$install_dir/logs/invalid-auths.log" --failregex="Failed login attempt from IP: <HOST>"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

ynh_systemctl --service="$app" --action="start" --wait_until="Stirling-PDF running on port" --log_path="$install_dir/logs/info.log"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Upgrade of $app completed"
